{
  // Cloudflare Worker (static assets) for the Veziroglu Consulting site.
  // Deploy:  npx wrangler deploy   (after `npx wrangler login`)
  "name": "vzr-site",
  "compatibility_date": "2026-07-01",
  "assets": {
    // Serve only the built site in public/ (keeps repo tooling out of the deploy).
    "directory": "./public",
    // Return index.html for unknown paths (single-page site).
    "not_found_handling": "single-page-application"
  }
}
